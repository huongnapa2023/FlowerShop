@{
    var currentCtrl = ViewContext.RouteData.Values["controller"] != null ? ViewContext.RouteData.Values["controller"].ToString() : "";
    var currentAct = ViewContext.RouteData.Values["action"] != null ? ViewContext.RouteData.Values["action"].ToString() : "";
    var siteSetting = FlowerShop.Services.AppHelpers.GetSiteSetting();
    var activeCampaign = FlowerShop.Services.AppHelpers.GetActiveCampaign();
    var shopName = !string.IsNullOrWhiteSpace(siteSetting.ShopName) ? siteSetting.ShopName : "CHAM Flowers";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @shopName | Tiệm Hoa Tươi Nghệ Thuật</title>
    <link rel="icon" type="image/svg+xml" href="~/images/logo-cham-icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/site.css?v=20261105_v3" />
</head>
<body>
    <!-- Top Promo Bar -->
    @if (siteSetting.ShowTopbar)
    {
        string topbarStyle = "";
        if (activeCampaign != null && !string.IsNullOrEmpty(activeCampaign.ThemeColor))
        {
            topbarStyle = "background: linear-gradient(90deg, " + activeCampaign.ThemeColor + ", #1e293b);";
        }
        else if (!string.IsNullOrWhiteSpace(siteSetting.TopbarBgColor))
        {
            topbarStyle = "background: " + siteSetting.TopbarBgColor + ";";
        }
        <div class="nt-topbar" @(!string.IsNullOrEmpty(topbarStyle) ? Html.Raw("style=\"" + topbarStyle + "\"") : null)>
            <div class="container d-flex flex-wrap justify-content-between align-items-center">
                <div>
                    @if (activeCampaign != null)
                    {
                        <i class="bi bi-stars text-warning me-1"></i>
                        if (!string.IsNullOrEmpty(activeCampaign.TargetUrl))
                        {
                            <a href="@activeCampaign.TargetUrl" class="text-white text-decoration-none fw-semibold">
                                @(string.IsNullOrEmpty(activeCampaign.PromoBarText) ? activeCampaign.Name : activeCampaign.PromoBarText)
                            </a>
                        }
                        else
                        {
                            <span>@(string.IsNullOrEmpty(activeCampaign.PromoBarText) ? activeCampaign.Name : activeCampaign.PromoBarText)</span>
                        }
                        if (!string.IsNullOrEmpty(activeCampaign.CouponCode))
                        {
                            <span class="badge bg-warning text-dark ms-2 font-monospace">@activeCampaign.CouponCode</span>
                        }
                    }
                    else
                    {
                        <i class="bi bi-flower1 me-1"></i>
                        <span>@(string.IsNullOrWhiteSpace(siteSetting.DefaultTopbarText) ? "Giao hoa tươi hỏa tốc 2H nội thành TP.HCM • Nhập mã CHAMFLOWERS15 giảm ngay 15%" : siteSetting.DefaultTopbarText)</span>
                    }
                </div>
                <div class="d-none d-md-flex align-items-center gap-3">
                    @if (activeCampaign != null && !string.IsNullOrEmpty(activeCampaign.TargetUrl))
                    {
                        <a href="@activeCampaign.TargetUrl" class="text-white text-decoration-none fw-semibold">
                            <i class="bi bi-gift-fill text-warning me-1"></i> @activeCampaign.Name
                        </a>
                        <span>|</span>
                    }
                    @if (siteSetting.ShowHotDealButton)
                    {
                        <a href="javascript:void(0)" class="text-white text-decoration-none fw-semibold js-open-hotdeal">
                            <i class="bi bi-lightning-charge-fill text-warning"></i> Ưu đãi hôm nay
                        </a>
                        <span>|</span>
                    }
                    <span><i class="bi bi-telephone-fill me-1"></i> Hotline: @(string.IsNullOrWhiteSpace(siteSetting.Hotline) ? "1900 6868" : siteSetting.Hotline)</span>
                </div>
            </div>
        </div>
    }

    <!-- Main Navbar -->
    <header class="sticky-top nt-navbar" @(!string.IsNullOrWhiteSpace(siteSetting.HeaderBgColor) ? Html.Raw("style=\"background-color:" + siteSetting.HeaderBgColor + ";\"") : null)>
        <nav class="navbar navbar-expand-xl py-2">
            <div class="container-xxl px-lg-4">
                <a class="navbar-brand nt-brand d-flex align-items-center py-0 me-2 flex-shrink-0" href="@Url.Action("Index", "Home")">
                    <img src="@(string.IsNullOrWhiteSpace(siteSetting.LogoUrl) ? Url.Content("~/images/logo-cham.svg") : siteSetting.LogoUrl)" alt="@shopName" class="cham-logo-nav" />
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#ntMainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="ntMainNav">
                    @Html.Action("NavMenu", "Menu")

                    <div class="d-flex flex-wrap flex-xl-nowrap align-items-center gap-2 mt-2 mt-xl-0">
                        @if (siteSetting.ShowSearchBar)
                        {
                            <form action="@Url.Action("Index", "Product")" method="get" class="nt-search-form flex-grow-1 flex-xl-grow-0">
                                <div class="nt-search-box">
                                    <input type="text"
                                           name="search"
                                           value="@Request.QueryString["search"]"
                                           class="nt-search-input"
                                           placeholder="Tìm mẫu hoa tươi..."
                                           autocomplete="off" />
                                    <button class="nt-search-btn" type="submit" title="Tìm kiếm hoa">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                            </form>
                        }

                        <a href="@Url.Action("Cart", "Order")" class="nt-cart-btn position-relative flex-shrink-0" title="Giỏ hàng">
                            <i class="bi bi-bag-heart-fill"></i>
                            <span id="cartCountBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">0</span>
                        </a>

                        @if (User != null && User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            if (User.IsInRole("Admin"))
                            {
                                <a href="@Url.Action("Index", "Report")" class="btn btn-sm btn-dark rounded-pill px-3 fw-semibold nt-nav-action-btn flex-shrink-0">
                                    <i class="bi bi-speedometer2 me-1"></i> Quản trị
                                </a>
                            }
                            <div class="dropdown flex-shrink-0">
                                <button class="btn btn-nt-outline btn-sm dropdown-toggle d-flex align-items-center gap-1 nt-nav-action-btn" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i>
                                    <span class="text-truncate" style="max-width:125px">@User.Identity.Name</span>
                                    @if (AppHelpers.GetCurrentIsVip(User))
                                    {
                                        <span class="badge bg-warning text-dark ms-1">VIP</span>
                                    }
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-2">
                                    <li><a class="dropdown-item rounded-3 py-2" href="@Url.Action("Profile", "Account")"><i class="bi bi-person-gear me-2 text-danger"></i>Tài khoản cá nhân</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" href="@Url.Action("MyOrders", "Order")"><i class="bi bi-receipt-cutoff me-2 text-danger"></i>Đơn hàng của tôi</a></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item rounded-3 py-2 fw-bold text-primary" href="@Url.Action("Index", "Report")"><i class="bi bi-shield-lock me-2"></i>Hệ thống Quản trị</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item rounded-3 py-2 text-danger" href="@Url.Action("Logout", "Account")"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a href="@Url.Action("Login", "Account")" class="btn btn-nt-outline btn-sm nt-nav-action-btn flex-shrink-0">Đăng nhập</a>
                            <a href="@Url.Action("Register", "Account")" class="btn btn-nt-primary btn-sm nt-nav-action-btn flex-shrink-0">Đăng ký</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Floating AJAX Toast Container -->
    <div id="ntToastContainer"></div>

    <!-- Server TempData Alerts -->
    <div class="container mt-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-0" role="alert">
                <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <!-- HotDealPopup Modal (Dynamic Popup Builder) -->
    <div class="modal fade" id="hotDealPopupModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" id="hdPopupDialog">
            <div class="modal-content border-0 rounded-4 overflow-hidden shadow-lg position-relative">
                <button type="button"
                        class="btn position-absolute top-0 end-0 m-3 rounded-circle d-inline-flex align-items-center justify-content-center shadow"
                        style="width:36px;height:36px;z-index:20;background:rgba(15,23,42,0.75);color:#ffffff;border:2px solid rgba(255,255,255,0.9);padding:0;line-height:1;"
                        data-bs-dismiss="modal"
                        aria-label="Đóng">
                    <i class="bi bi-x-lg" style="font-size:1rem;-webkit-text-stroke:0.5px #fff;"></i>
                </button>
                <div id="hdPopupDynamicBody">
                    <div class="position-relative">
                        <img id="hdPopupImg" src="/images/samflora/b12-main.jpg" class="w-100" style="height:265px;object-fit:cover;object-position:center 35%" alt="Hot Deal CHAM Flowers" />
                    </div>
                    <div class="p-4 text-center bg-white">
                        <h4 id="hdPopupTitle" class="serif-heading fw-bold text-danger mb-2">Ưu đãi Hoa Tươi CHAM Flowers</h4>
                        <p id="hdPopupSub" class="text-muted small mb-3"></p>
                        <div class="d-none mb-3">
                            <span class="badge bg-danger-subtle text-danger fs-6 px-3 py-2 rounded-pill">
                                Mã ưu đãi: <strong id="hdPopupCoupon">CHAMFLOWERS15</strong>
                            </span>
                        </div>
                        <a id="hdPopupLink" href="/HotDeal" class="btn btn-nt-primary w-100 py-2">Xem ngay chương trình khuyến mãi</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Floating Live Chat Widget -->
    @if (siteSetting.ShowFloatingChat)
    {
        <button id="ntChatLauncher" class="nt-chat-launcher" title="Chat tư vấn trực tuyến cùng @shopName">
            <i class="bi bi-chat-heart-fill"></i>
        </button>

        <div id="ntChatPanel" class="nt-chat-panel">
            <div class="nt-chat-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <img src="~/images/logo-cham-icon.svg" class="rounded-circle bg-white p-0 shadow-sm" style="width:38px;height:38px" alt="@shopName" />
                    <div>
                        <div class="fw-bold small">CSKH @shopName</div>
                        <div style="font-size:0.74rem"><span class="badge bg-success rounded-circle p-1 me-1"> </span>Trực tuyến • Tư vấn mẫu hoa 24/7</div>
                    </div>
                </div>
                <button id="ntChatClose" type="button" class="btn btn-sm text-white"><i class="bi bi-x-lg"></i></button>
            </div>
            <div id="ntChatMessages" class="nt-chat-messages">
                <div class="chat-bubble system">Xin chào! Bạn cần tư vấn hoa sinh nhật, khai trương hay thiết kế bó hoa theo ngân sách? Nhắn cho @shopName ngay nhé!</div>
            </div>
            <form id="ntChatForm" class="p-2 border-top bg-white d-flex gap-2">
                <input id="ntChatInput" type="text" class="form-control form-control-sm rounded-pill px-3" placeholder="Nhập tin nhắn cần tư vấn..." autocomplete="off" />
                <button type="submit" class="btn btn-nt-primary btn-sm px-3"><i class="bi bi-send-fill"></i></button>
            </form>
        </div>
    }

    <!-- Footer -->
    @{
        var footerBg = !string.IsNullOrWhiteSpace(siteSetting.FooterBgColor) ? siteSetting.FooterBgColor : "#18181b";
        var footerText = !string.IsNullOrWhiteSpace(siteSetting.FooterTextColor) ? siteSetting.FooterTextColor : "#e2e8f0";
        var col1Items = (siteSetting.FooterCol1Links ?? "").Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
        var col2Items = (siteSetting.FooterCol2Links ?? "").Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
    }
    <footer class="nt-footer pt-5 pb-4 mt-5" style="background:@footerBg; color:@footerText;">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <img src="@(string.IsNullOrWhiteSpace(siteSetting.FooterLogoUrl) ? Url.Content("~/images/logo-cham-white.svg") : siteSetting.FooterLogoUrl)" alt="@shopName" class="cham-logo-footer mb-3" />
                    <p class="small opacity-75">@(string.IsNullOrWhiteSpace(siteSetting.FooterAbout) ? "Thương hiệu hoa tươi nghệ thuật cao cấp chuyên cung cấp hoa sinh nhật, hoa khai trương, lan hồ điệp và hoa cưới thiết kế độc bản. Cam kết hoa tươi mới mỗi ngày từ Đà Lạt & nhập khẩu." : siteSetting.FooterAbout)</p>
                    <div class="small opacity-75">
                        @if (!string.IsNullOrWhiteSpace(siteSetting.Address))
                        {
                            <div><i class="bi bi-geo-alt-fill text-danger me-2"></i>@siteSetting.Address</div>
                        }
                        <div class="mt-1">
                            <i class="bi bi-telephone-fill text-danger me-2"></i>Hotline: @(string.IsNullOrWhiteSpace(siteSetting.Hotline) ? "1900 6868" : siteSetting.Hotline)
                            @if (!string.IsNullOrWhiteSpace(siteSetting.SecondaryPhone))
                            {
                                <span>• @siteSetting.SecondaryPhone</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(siteSetting.Email))
                        {
                            <div class="mt-1"><i class="bi bi-envelope-fill text-danger me-2"></i>@siteSetting.Email</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(siteSetting.WorkingHours))
                        {
                            <div class="mt-1"><i class="bi bi-clock-fill text-danger me-2"></i>@siteSetting.WorkingHours</div>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(siteSetting.FacebookUrl) || !string.IsNullOrWhiteSpace(siteSetting.InstagramUrl) || !string.IsNullOrWhiteSpace(siteSetting.ZaloUrl) || !string.IsNullOrWhiteSpace(siteSetting.TikTokUrl))
                    {
                        <div class="d-flex align-items-center gap-2 mt-3">
                            @if (!string.IsNullOrWhiteSpace(siteSetting.FacebookUrl))
                            {
                                <a href="@siteSetting.FacebookUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-light rounded-circle d-inline-flex align-items-center justify-content-center" style="width:34px;height:34px;" title="Facebook"><i class="bi bi-facebook"></i></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(siteSetting.InstagramUrl))
                            {
                                <a href="@siteSetting.InstagramUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-light rounded-circle d-inline-flex align-items-center justify-content-center" style="width:34px;height:34px;" title="Instagram"><i class="bi bi-instagram"></i></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(siteSetting.ZaloUrl))
                            {
                                <a href="@siteSetting.ZaloUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-light rounded-circle d-inline-flex align-items-center justify-content-center" style="width:34px;height:34px;" title="Zalo"><i class="bi bi-chat-dots-fill"></i></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(siteSetting.TikTokUrl))
                            {
                                <a href="@siteSetting.TikTokUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-light rounded-circle d-inline-flex align-items-center justify-content-center" style="width:34px;height:34px;" title="TikTok"><i class="bi bi-tiktok"></i></a>
                            }
                        </div>
                    }
                </div>
                <div class="col-6 col-lg-3">
                    <h6 class="text-white fw-bold mb-3">@(string.IsNullOrWhiteSpace(siteSetting.FooterCol1Title) ? "Danh mục hoa" : siteSetting.FooterCol1Title)</h6>
                    <ul class="list-unstyled small opacity-75 d-grid gap-2">
                        @if (col1Items.Length > 0)
                        {
                            foreach (var rawLine in col1Items)
                            {
                                var parts = rawLine.Split('|');
                                var label = parts[0].Trim();
                                var link = parts.Length > 1 ? parts[1].Trim() : "";
                                if (!string.IsNullOrWhiteSpace(label))
                                {
                                    if (!string.IsNullOrWhiteSpace(link))
                                    {
                                        <li><a href="@link" class="text-reset text-decoration-none">@label</a></li>
                                    }
                                    else
                                    {
                                        <li><span>@label</span></li>
                                    }
                                }
                            }
                        }
                    </ul>
                </div>
                <div class="col-6 col-lg-4">
                    <h6 class="text-white fw-bold mb-3">@(string.IsNullOrWhiteSpace(siteSetting.FooterCol2Title) ? "Hỗ trợ khách hàng" : siteSetting.FooterCol2Title)</h6>
                    <ul class="list-unstyled small opacity-75 d-grid gap-2">
                        @if (col2Items.Length > 0)
                        {
                            foreach (var rawLine in col2Items)
                            {
                                var parts = rawLine.Split('|');
                                var label = parts[0].Trim();
                                var link = parts.Length > 1 ? parts[1].Trim() : "";
                                if (!string.IsNullOrWhiteSpace(label))
                                {
                                    if (!string.IsNullOrWhiteSpace(link))
                                    {
                                        <li><a href="@link" class="text-reset text-decoration-none">@label</a></li>
                                    }
                                    else
                                    {
                                        <li><span>@label</span></li>
                                    }
                                }
                            }
                        }
                    </ul>
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <div class="text-center small opacity-75">
                @(string.IsNullOrWhiteSpace(siteSetting.CopyrightText) ? "© 2026 CHAM Flowers." : siteSetting.CopyrightText)
            </div>
        </div>
    </footer>

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/jquery.signalR-2.2.2.min.js"></script>
    <script src="~/signalr/hubs"></script>
    <script src="~/Scripts/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
