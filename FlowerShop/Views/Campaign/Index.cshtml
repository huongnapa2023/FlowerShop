@model IEnumerable<FlowerShop.Models.Campaign>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Quản lý Chiến dịch & Mùa Lễ Hội";
    string currentSeason = ViewBag.Season as string ?? "All";
    string currentSearch = ViewBag.Search as string ?? "";
}

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Tổng chiến dịch</span>
                <span class="badge bg-secondary-subtle text-secondary rounded-pill p-2"><i class="bi bi-collection-fill"></i></span>
            </div>
            <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalCount</h3>
            <div class="small text-muted mt-1">Toàn bộ chiến dịch trong hệ thống</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-success">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-success small fw-semibold">Đang hoạt động</span>
                <span class="badge bg-success-subtle text-success rounded-pill p-2"><i class="bi bi-broadcast"></i></span>
            </div>
            <h3 class="fw-bold mb-0 text-success">@ViewBag.ActiveCount</h3>
            <div class="small text-muted mt-1">Đang hiển thị trên website khách hàng</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-warning">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-warning small fw-semibold">Sắp diễn ra</span>
                <span class="badge bg-warning-subtle text-warning rounded-pill p-2"><i class="bi bi-clock-history"></i></span>
            </div>
            <h3 class="fw-bold mb-0 text-dark">@ViewBag.UpcomingCount</h3>
            <div class="small text-muted mt-1">Đã lên lịch, tự động chạy khi đến ngày</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Đã kết thúc</span>
                <span class="badge bg-light text-muted border rounded-pill p-2"><i class="bi bi-check2-all"></i></span>
            </div>
            <h3 class="fw-bold mb-0 text-muted">@ViewBag.ExpiredCount</h3>
            <div class="small text-muted mt-1">Quá hạn, đã tự động hạ xuống</div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" action="@Url.Action("Index")" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Tìm theo tên sự kiện, thanh promo, mã voucher..." value="@currentSearch" />
                </div>
            </div>
            <div class="col-md-4">
                <select name="season" class="form-select" onchange="this.form.submit()">
                    <option value="All" @(currentSeason == "All" ? "selected" : "")>Tất cả mùa lễ hội</option>
                    <option value="20-11" @(currentSeason == "20-11" ? "selected" : "")>Tri Ân 20/11</option>
                    <option value="Noel" @(currentSeason == "Noel" ? "selected" : "")>Giáng Sinh (Noel)</option>
                    <option value="Tet" @(currentSeason == "Tet" ? "selected" : "")>Tết Nguyên Đán</option>
                    <option value="Valentine" @(currentSeason == "Valentine" ? "selected" : "")>Valentine 14/2</option>
                    <option value="8-3" @(currentSeason == "8-3" ? "selected" : "")>Quốc Tế Phụ Nữ 8/3</option>
                    <option value="Other" @(currentSeason == "Other" ? "selected" : "")>Sự kiện khác</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-danger w-100 rounded-3">
                    <i class="bi bi-funnel-fill me-1"></i> Lọc dữ liệu
                </button>
                @if (!string.IsNullOrEmpty(currentSearch) || currentSeason != "All")
                {
                    <a href="@Url.Action("Index")" class="btn btn-light border rounded-3" title="Xóa bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Danh sách chiến dịch -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-calendar-event-fill text-danger me-2"></i>Danh Sách Chiến Dịch Lễ Hội
        </h6>
        <a href="@Url.Action("Create")" class="btn btn-sm btn-danger rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Tạo chiến dịch mới</span>
        </a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div class="display-6 text-muted mb-3"><i class="bi bi-calendar-x"></i></div>
                <h5 class="fw-bold text-dark">Chưa có chiến dịch nào phù hợp</h5>
                <p class="text-muted small mb-3">Tạo chiến dịch lễ hội đầu tiên để tự động tùy biến website của bạn theo từng dịp lễ trong năm.</p>
                <a href="@Url.Action("Create")" class="btn btn-danger btn-sm rounded-pill px-3">
                    <i class="bi bi-plus-lg me-1"></i> Tạo chiến dịch ngay
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase fw-semibold">
                        <tr>
                            <th class="ps-3 py-3" style="width: 25%;">Chiến dịch & Dịp lễ</th>
                            <th style="width: 20%;">Thời gian & Trạng thái</th>
                            <th style="width: 25%;">Thanh Promo & Voucher</th>
                            <th style="width: 15%;">Banner Hero</th>
                            <th class="text-end pe-3" style="width: 15%;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            bool isActiveNow = item.IsActiveNow;
                            <tr class="@(isActiveNow ? "table-success-subtle border-start border-4 border-success" : "")">
                                <td class="ps-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center text-white" 
                                             style="background-color: @(string.IsNullOrEmpty(item.ThemeColor) ? "#be123c" : item.ThemeColor); width: 36px; height: 36px;">
                                            <i class="bi bi-gift-fill small"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                                <span>@item.Name</span>
                                                @if (isActiveNow)
                                                {
                                                    <span class="badge bg-success rounded-pill" style="font-size: 0.68rem;">
                                                        <i class="bi bi-broadcast me-1"></i> LIVE NOW
                                                    </span>
                                                }
                                            </div>
                                            <div class="text-muted small mt-1">
                                                <span class="badge bg-light text-dark border">@item.SeasonType</span>
                                                @if (!string.IsNullOrEmpty(item.TargetUrl))
                                                {
                                                    <a href="@item.TargetUrl" target="_blank" class="text-decoration-none text-muted ms-1" title="Xem link đích">
                                                        <i class="bi bi-box-arrow-up-right small"></i>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="small fw-semibold text-dark">
                                        <i class="bi bi-calendar-range text-muted me-1"></i>
                                        @item.StartDate.ToString("dd/MM/yyyy") &rarr; @item.EndDate.ToString("dd/MM/yyyy")
                                    </div>
                                    <div class="mt-1">
                                        <span class="badge @item.StatusBadgeClass rounded-pill" style="font-size: 0.72rem;">
                                            @item.StatusLabel
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.PromoBarText))
                                    {
                                        <div class="small text-truncate" style="max-width: 280px;" title="@item.PromoBarText">
                                            <i class="bi bi-megaphone-fill text-danger me-1"></i>
                                            @item.PromoBarText
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">(Mặc định)</span>
                                    }
                                    <div class="d-flex align-items-center gap-2 mt-1">
                                        @if (!string.IsNullOrEmpty(item.CouponCode))
                                        {
                                            <span class="badge bg-warning text-dark font-monospace" style="font-size: 0.7rem;">
                                                <i class="bi bi-ticket-perforated-fill me-1"></i>@item.CouponCode
                                            </span>
                                        }
                                        @if (item.DiscountPercent.HasValue && item.DiscountPercent > 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger" style="font-size: 0.7rem;">
                                                -@item.DiscountPercent%
                                            </span>
                                        }
                                        <span class="badge rounded-pill border" style="background: @item.ThemeColor; color: #fff; font-size: 0.65rem;" title="Mã màu chủ đạo">
                                            @item.ThemeColor
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.BannerUrl))
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@item.BannerUrl" alt="@item.Name" class="rounded-3 shadow-sm object-fit-cover" style="width: 55px; height: 35px;" onerror="this.src='/images/samflora/editorial-2.jpg';" />
                                            <div class="small text-truncate" style="max-width: 100px;" title="@item.BannerTitle">
                                                @(string.IsNullOrEmpty(item.BannerTitle) ? "Đã cài đặt" : item.BannerTitle)
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Chưa có banner</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <!-- Nút Bật/Tắt Switch -->
                                        @using (Html.BeginForm("ToggleActive", "Campaign", new { id = item.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-success" : "btn-outline-secondary") rounded-pill px-2 py-1" 
                                                    title="@(item.IsActive ? "Bấm để tạm dừng chiến dịch" : "Bấm để kích hoạt chiến dịch")">
                                                <i class="bi @(item.IsActive ? "bi-toggle-on text-success" : "bi-toggle-off text-muted") fs-6 align-middle"></i>
                                                <span class="small align-middle">@(item.IsActive ? "Bật" : "Tắt")</span>
                                            </button>
                                        }

                                        <!-- Nút Sửa -->
                                        <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <!-- Nút Xóa Modal -->
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1" data-bs-toggle="modal" data-bs-target="#deleteCampModal_@item.Id" title="Xóa chiến dịch">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Modal -->
                                    <div class="modal fade" id="deleteCampModal_@item.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered modal-sm text-start">
                                            <div class="modal-content rounded-4 border-0 shadow">
                                                <div class="modal-body p-4 text-center">
                                                    <div class="text-danger display-5 mb-3"><i class="bi bi-exclamation-circle-fill"></i></div>
                                                    <h6 class="fw-bold mb-2">Xác nhận xóa chiến dịch?</h6>
                                                    <p class="text-muted small mb-3">Bạn có chắc chắn muốn xóa chiến dịch <strong>"@item.Name"</strong> không? Thao tác này không thể hoàn tác.</p>
                                                    <div class="d-flex justify-content-center gap-2">
                                                        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                                                        @using (Html.BeginForm("Delete", "Campaign", new { id = item.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger rounded-pill px-3">Xóa luôn</button>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
