@model FlowerShop.Models.Campaign
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Tạo Chiến Dịch Mới";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
        <i class="bi bi-plus-circle-fill text-danger"></i> Tạo Chiến Dịch Mùa Lễ Hội Mới
    </h5>
    <a href="@Url.Action("Index")" class="btn btn-sm btn-light border rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
    </a>
</div>

@using (Html.BeginForm("Create", "Campaign", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-4 py-2" })

    <div class="row g-4">
        <!-- Cột trái: Thông tin chính -->
        <div class="col-lg-8">
            <!-- Thẻ 1: Thông tin sự kiện -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-3 pb-0">
                    <h6 class="fw-bold text-dark d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-info-circle-fill text-danger"></i> Thông tin cơ bản chiến dịch
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold text-dark">Tên chiến dịch <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control rounded-3", placeholder = "Ví dụ: Tri Ân Thầy Cô 20/11, Giáng Sinh Noel 2026...", required = "required" })
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-dark">Dịp lễ hội (Phân loại)</label>
                            <select name="SeasonType" class="form-select rounded-3">
                                <option value="20-11">Tri Ân 20/11</option>
                                <option value="Noel">Giáng Sinh Noel</option>
                                <option value="Tet">Tết Nguyên Đán</option>
                                <option value="Valentine">Valentine 14/2</option>
                                <option value="8-3">Quốc Tế Phụ Nữ 8/3</option>
                                <option value="Other" selected>Dịp lễ / Sự kiện khác</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Ngày bắt đầu áp dụng <span class="text-danger">*</span></label>
                            <input type="date" name="StartDate" class="form-control rounded-3" value="@Model.StartDate.ToString("yyyy-MM-dd")" required />
                            <small class="text-muted" style="font-size:0.75rem">Chiến dịch tự động bật trên web từ ngày này.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Ngày kết thúc áp dụng <span class="text-danger">*</span></label>
                            <input type="date" name="EndDate" class="form-control rounded-3" value="@Model.EndDate.ToString("yyyy-MM-dd")" required />
                            <small class="text-muted" style="font-size:0.75rem">Hệ thống tự động hạ chiến dịch xuống sau ngày này.</small>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-semibold text-dark">Dòng chữ hiển thị trên thanh Promo Bar (Topbar)</label>
                            @Html.TextBoxFor(m => m.PromoBarText, new { @class = "form-control rounded-3", placeholder = "Ví dụ: Mùa Tri Ân 20/11: BST Hoa Tươi Tặng Thầy Cô • Nhập mã TRIAN2011 giảm 20%..." })
                            <small class="text-muted" style="font-size:0.75rem">Xuất hiện trên thanh bar trên cùng của website dành cho khách hàng.</small>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-semibold text-dark">Đường dẫn đích (Khi khách bấm vào dòng chữ/banner)</label>
                            @Html.TextBoxFor(m => m.TargetUrl, new { @class = "form-control rounded-3", placeholder = "/Product?search=20/11 hoặc /HotDeal" })
                            <small class="text-muted" style="font-size:0.75rem">Link điều hướng tới bộ sưu tập hoa của mùa lễ đó.</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thẻ 2: Banner Hero Trang Chủ -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-3 pb-0">
                    <h6 class="fw-bold text-dark d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-images text-danger"></i> Banner Trang Chủ Tự Động
                    </h6>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">Khi chiến dịch đến hạn kích hoạt, Banner này sẽ tự động được ưu tiên đưa lên vị trí đầu tiên trong Carousel trang chủ.</p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Tiêu đề lớn trên Banner</label>
                            @Html.TextBoxFor(m => m.BannerTitle, new { @class = "form-control rounded-3", placeholder = "Ví dụ: MÙA TRI ÂN 20/11 - TÔN VINH NGHỀ GIÁO" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Dòng mô tả phụ trên Banner</label>
                            @Html.TextBoxFor(m => m.BannerSubtitle, new { @class = "form-control rounded-3", placeholder = "Ví dụ: Gửi trọn lòng biết ơn sâu sắc qua từng đóa hoa tươi thắm" })
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-dark">Tải ảnh Banner lên (Khuyên dùng tỉ lệ 16:9, tối thiểu 1200x500px)</label>
                            <input type="file" name="bannerImage" class="form-control rounded-3" accept="image/*" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-dark">Hoặc nhập link URL ảnh trực tiếp</label>
                            @Html.TextBoxFor(m => m.BannerUrl, new { @class = "form-control rounded-3", placeholder = "https://images.unsplash.com/..." })
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Cấu hình Voucher & Màu sắc & Đăng bài -->
        <div class="col-lg-4">
            <!-- Thẻ Voucher & Giảm giá -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-3 pb-0">
                    <h6 class="fw-bold text-dark d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-ticket-perforated-fill text-danger"></i> Voucher Khuyến Mãi
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Mã Voucher gắn kèm</label>
                        @Html.TextBoxFor(m => m.CouponCode, new { @class = "form-control rounded-3 text-uppercase font-monospace fw-bold", placeholder = "TRIAN2011, NOEL25..." })
                        <small class="text-muted" style="font-size:0.75rem">Mã giảm giá để khách nhập khi mua hàng.</small>
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-semibold text-dark">Phần trăm giảm giá (%)</label>
                        @Html.TextBoxFor(m => m.DiscountPercent, new { @class = "form-control rounded-3", type = "number", min = "0", max = "100", placeholder = "Ví dụ: 20" })
                    </div>
                </div>
            </div>

            <!-- Thẻ Giao diện & Màu sắc -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-3 pb-0">
                    <h6 class="fw-bold text-dark d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-palette-fill text-danger"></i> Màu sắc Chủ Đạo (Theme)
                    </h6>
                </div>
                <div class="card-body">
                    <label class="form-label small fw-semibold text-dark">Mã màu nhận diện thương hiệu dịp lễ</label>
                    <div class="d-flex align-items-center gap-2">
                        <input type="color" id="colorPicker" class="form-control form-control-color rounded-3 border" value="@Model.ThemeColor" title="Chọn màu" onchange="document.getElementById('themeColorInput').value = this.value;" />
                        @Html.TextBoxFor(m => m.ThemeColor, new { @class = "form-control rounded-3 font-monospace", id = "themeColorInput", placeholder = "#be123c", onchange = "document.getElementById('colorPicker').value = this.value;" })
                    </div>
                    <div class="mt-2 small text-muted">
                        Gợi ý màu lễ hội:
                        <div class="d-flex gap-2 mt-1">
                            <span class="badge border text-white p-2" style="background:#881337;cursor:pointer" onclick="setTheme('#881337')">20/11</span>
                            <span class="badge border text-white p-2" style="background:#15803d;cursor:pointer" onclick="setTheme('#15803d')">Noel</span>
                            <span class="badge border text-white p-2" style="background:#d97706;cursor:pointer" onclick="setTheme('#d97706')">Tết</span>
                            <span class="badge border text-white p-2" style="background:#ec4899;cursor:pointer" onclick="setTheme('#ec4899')">Valentine</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thẻ Trạng thái & Lưu -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="form-check form-switch mb-3">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", role = "switch", id = "isActiveSwitch" })
                        <label class="form-check-label fw-bold text-dark" for="isActiveSwitch">
                            Kích hoạt chiến dịch
                        </label>
                        <div class="small text-muted">Nếu bật, hệ thống sẽ tự động hiển thị khi đến ngày áp dụng.</div>
                    </div>

                    <hr class="my-3" />

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger rounded-pill py-2 fw-semibold shadow-sm">
                            <i class="bi bi-check-circle-fill me-1"></i> Lưu và Kích hoạt
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-light rounded-pill py-2 border text-muted">
                            <i class="bi bi-x-lg me-1"></i> Hủy bỏ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>
    function setTheme(hex) {
        document.getElementById('themeColorInput').value = hex;
        document.getElementById('colorPicker').value = hex;
    }
</script>
