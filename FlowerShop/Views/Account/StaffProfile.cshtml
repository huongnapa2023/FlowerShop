@model FlowerShop.Models.User
@using FlowerShop.Models
@using FlowerShop.Services
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Hồ sơ Cá nhân Nhân sự - " + Model.FullName;

    var allPermissions = ViewBag.AllPermissions as List<string> ?? AdminPermissions.GetAll();
    var descriptions = ViewBag.PermissionDescriptions as Dictionary<string, string> ?? AdminPermissions.Descriptions;
    var badges = ViewBag.PermissionBadges as Dictionary<string, string> ?? AdminPermissions.Badges;

    var allowedSet = new HashSet<string>(
        !string.IsNullOrWhiteSpace(Model.AllowedPermissions)
            ? Model.AllowedPermissions.Split(new[] { ',', ';', '|' }, StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim().ToUpperInvariant())
            : Enumerable.Empty<string>(),
        StringComparer.OrdinalIgnoreCase);

    int grantedCount = Model.IsSuperAdmin ? allPermissions.Count : allPermissions.Count(p => allowedSet.Contains(p));
    string empCode = string.Format("EMP-{0:D4}", Model.Id);
}

<div class="container-fluid px-0">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Report")" class="text-decoration-none text-muted">Trang chủ</a></li>
                    <li class="breadcrumb-item active text-danger fw-bold" aria-current="page">Hồ sơ cá nhân nhân sự</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-person-vcard text-danger"></i>
                <span>Hồ Sơ Của Tôi:</span>
                <span class="text-danger">@Model.FullName</span>
            </h4>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill small">
                <i class="bi bi-geo-alt-fill text-danger me-1"></i>@(string.IsNullOrWhiteSpace(Model.Address) ? "Trụ sở Tổng Hà Nội" : Model.Address)
            </span>
        </div>
    </div>

    <!-- Alert thông báo -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success me-2"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger me-2"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Cột Trái: Thẻ Định Danh & Đổi Mật Khẩu -->
        <div class="col-lg-4">
            <!-- Thẻ Nhân Sự -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="p-4 text-center text-white" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
                    <div class="position-relative d-inline-block mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-lg mx-auto"
                             style="width:88px;height:88px;background:@(Model.IsSuperAdmin ? "linear-gradient(135deg, #881337, #be123c)" : "linear-gradient(135deg, #0284c7, #0369a1)");font-size:2rem;border:4px solid rgba(255,255,255,0.25)">
                            @AppHelpers.GetInitials(Model.FullName)
                        </div>
                        <span class="position-absolute bottom-0 end-0 p-2 bg-success border border-2 border-white rounded-circle" title="Trực tuyến"></span>
                    </div>

                    <h5 class="fw-bold mb-1 text-white">@Model.FullName</h5>
                    <div class="text-light-emphasis small mb-2">@Model.Email</div>

                    <div class="d-flex flex-wrap justify-content-center gap-1">
                        <span class="badge bg-white text-dark rounded-pill px-3 py-1 fw-bold">
                            <i class="bi bi-hash text-danger"></i>@empCode
                        </span>
                        <span class="badge bg-success rounded-pill px-3 py-1">Đang công tác</span>
                    </div>
                </div>

                <div class="card-body p-4 bg-white">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="text-muted small fw-semibold">Cơ sở trực thuộc:</span>
                        <span class="fw-bold text-dark text-end">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>@(string.IsNullOrWhiteSpace(Model.Address) ? "Trụ sở Tổng Hà Nội" : Model.Address)
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="text-muted small fw-semibold">Số điện thoại:</span>
                        <span class="fw-bold text-dark">
                            <i class="bi bi-telephone-fill text-success me-1"></i>@(string.IsNullOrWhiteSpace(Model.Phone) ? "Chưa cập nhật" : Model.Phone)
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="text-muted small fw-semibold">Vai trò phân công:</span>
                        <span class="badge @(Model.IsSuperAdmin ? "bg-danger" : "bg-primary") rounded-pill px-3 py-1">
                            @(Model.IsSuperAdmin ? "Admin Tổng (Super Admin)" : "Quản trị viên Chi nhánh")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-semibold">Ngày tham gia:</span>
                        <span class="text-dark small">@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
            </div>

            <!-- Form Đổi Mật Khẩu Cá Nhân -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-shield-lock-fill text-danger me-2"></i>Đổi Mật Khẩu Đăng Nhập</h6>
                </div>
                <div class="card-body p-4 bg-white">
                    @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Mật khẩu hiện tại (*)</label>
                            <input type="password" name="CurrentPassword" class="form-control" required placeholder="Nhập mật khẩu cũ" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Mật khẩu mới (*)</label>
                            <input type="password" name="NewPassword" class="form-control" required minlength="6" placeholder="Tối thiểu 6 ký tự" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Xác nhận mật khẩu mới (*)</label>
                            <input type="password" name="ConfirmPassword" class="form-control" required minlength="6" placeholder="Nhập lại mật khẩu mới" />
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-sm btn-nt-primary rounded-pill py-2 shadow-sm">
                                <i class="bi bi-key-fill me-1"></i>Cập nhật mật khẩu
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Cột Phải: Cập Nhật Thông Tin & Thẩm Quyền Của Tôi -->
        <div class="col-lg-8">
            <!-- Form Cập Nhật Thông Tin Cá Nhân -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-person-lines-fill text-danger me-2"></i>Thông Tin Liên Hệ & Nhân Sự</h6>
                </div>
                <div class="card-body p-4 bg-white">
                    @using (Html.BeginForm("UpdateMyStaffProfile", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Email công vụ</label>
                                <input type="text" class="form-control bg-light" value="@Model.Email" readonly disabled />
                                <div class="form-text" style="font-size:0.75rem">Email đăng nhập do Admin Tổng cấp quản lý.</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Cơ sở / Chi nhánh làm việc</label>
                                <input type="text" class="form-control bg-light" value="@Model.Address" readonly disabled />
                                <div class="form-text" style="font-size:0.75rem">Địa bàn cơ sở do Admin Tổng điều phối.</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Họ và tên của bạn (*)</label>
                                <input type="text" name="fullName" class="form-control" value="@Model.FullName" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Số điện thoại liên hệ (*)</label>
                                <input type="text" name="phone" class="form-control" value="@Model.Phone" required />
                            </div>

                            <div class="col-12 text-end pt-2">
                                <button type="submit" class="btn btn-sm btn-dark rounded-pill px-4 py-2 shadow-sm">
                                    <i class="bi bi-floppy-fill me-1"></i>Lưu thay đổi thông tin
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Bảng Thẩm Quyền Được Giao -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-shield-check text-success me-2"></i>Thẩm Quyền & Phân Quyền Được Giao Của Bạn</h6>
                        <span class="text-muted small">Các quyền hạn bạn được phép thực thi trên hệ thống CHAM Flowers</span>
                    </div>
                    <div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill small fw-bold">
                            @grantedCount / @allPermissions.Count Phân hệ được cấp
                        </span>
                    </div>
                </div>

                <div class="card-body p-4 bg-white">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th class="ps-3" style="width:45%">Phân Hệ Nghiệp Vụ</th>
                                    <th class="text-center" style="width:20%">Quyền Truy Cập</th>
                                    <th class="text-center" style="width:35%">Cấp Độ Quyền (CRUD)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var perm in allPermissions)
                                {
                                    bool isMainChecked = Model.IsSuperAdmin || allowedSet.Contains(perm);
                                    bool hasCrud = AdminPermissions.SupportsCrud(perm);
                                    string icon = badges.ContainsKey(perm) ? badges[perm] : "bi-check";
                                    string desc = descriptions.ContainsKey(perm) ? descriptions[perm] : perm;

                                    bool canCreate = Model.IsSuperAdmin || allowedSet.Contains(AdminPermissions.CreateOf(perm));
                                    bool canEdit = Model.IsSuperAdmin || allowedSet.Contains(AdminPermissions.EditOf(perm));
                                    bool canDelete = Model.IsSuperAdmin || allowedSet.Contains(AdminPermissions.DeleteOf(perm));

                                    <tr class="@(isMainChecked ? "" : "table-light opacity-75")">
                                        <td class="ps-3 py-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 @(isMainChecked ? "bg-danger-subtle text-danger" : "bg-secondary-subtle text-secondary")" style="width:32px;height:32px">
                                                    <i class="bi @icon" style="font-size:0.85rem"></i>
                                                </div>
                                                <div class="small fw-bold text-dark">@desc</div>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            @if (isMainChecked)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill" style="font-size:0.7rem">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Được phép
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 rounded-pill" style="font-size:0.7rem">
                                                    <i class="bi bi-lock-fill me-1"></i>Không có quyền
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (!isMainChecked)
                                            {
                                                <span class="text-muted small fst-italic" style="font-size:0.75rem">Không khả dụng</span>
                                            }
                                            else if (!hasCrud)
                                            {
                                                <span class="badge bg-light text-dark border px-2 py-1 rounded-pill" style="font-size:0.7rem">Xem toàn phần</span>
                                            }
                                            else
                                            {
                                                <div class="d-flex justify-content-center gap-1">
                                                    <span class="badge @(canCreate ? "bg-success text-white" : "bg-light text-muted border") px-2 py-1 rounded-pill" style="font-size:0.7rem">
                                                        @(canCreate ? "+Thêm: Có" : "+Thêm: Không")
                                                    </span>
                                                    <span class="badge @(canEdit ? "bg-primary text-white" : "bg-light text-muted border") px-2 py-1 rounded-pill" style="font-size:0.7rem">
                                                        @(canEdit ? "✎Sửa: Có" : "✎Sửa: Không")
                                                    </span>
                                                    <span class="badge @(canDelete ? "bg-danger text-white" : "bg-light text-muted border text-decoration-line-through") px-2 py-1 rounded-pill" style="font-size:0.7rem">
                                                        @(canDelete ? "🗑Xoá: Có" : "🗑Xoá: CẤM")
                                                    </span>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
